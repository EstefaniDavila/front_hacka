{
  "expo": {
    "name": "front_hacka",
    "slug": "front_hacka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vecired.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a VeciRed IA acceder a la cámara frontal para la verificación biométrica de identidad."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a VeciRed IA seleccionar las fotos de tu DNI desde la galería para verificar tu identidad."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_USE_RN_FETCH": "true"
    }
  }
}
